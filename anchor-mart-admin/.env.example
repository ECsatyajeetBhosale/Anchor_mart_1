# Environment Variables — AnchorMart Admin
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this template is not.

# API base URL (Django backend) — must end with /api
# Free ngrok tunnels get a new subdomain on every restart, so paste your
# current tunnel URL here rather than reusing whatever is committed.
VITE_API_BASE_URL=ANCHOR_MART_ADMIN_URLs

# Local backend instead:
# VITE_API_BASE_URL=http://localhost:8000/api

# App name (optional — shown in browser tab)
VITE_APP_NAME=AnchorMart Admin

# Shared client secret for the `/api/chat/` mounts (attachment upload).
# The `/api/superadmin/` prefix is exempt and does not need it.
# Ask the backend team for the current value — never commit a real one here.
VITE_SERVER_SECRET_KEY=ANCHOR_MART_SERVER_SECRET_KEY

# ── Browser push (Flow 21 §9) ────────────────────────────────────────────────
# Firebase Web config. Leave every line blank and push stays dark: the header
# button hides itself and nothing else in the panel changes. Fill all six in to
# turn it on — a partial config counts as unconfigured.
#
# Console → Project settings → General → "Your apps" → Web app → SDK setup:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
#
# Console → Project settings → Cloud Messaging → Web configuration → Web Push
# certificates. This is the PUBLIC half of the key pair ("Key pair" column), not
# the server key. Without it getToken() fails with token-subscribe-failed.
VITE_FIREBASE_VAPID_KEY=
#
# None of these are secrets — Firebase Web config identifies the project, it does
# not authorise anything. They ship in the bundle like every other VITE_* var.
# Use the SAME project the backend's FCM service account belongs to, or tokens
# registered here will be minted against a project the backend cannot push to.
