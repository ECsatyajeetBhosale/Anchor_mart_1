# Environment Variables — AnchorMart Admin
#
# This is the committed template. Every real env file is gitignored.
#
# ── File layout ──────────────────────────────────────────────────────────────
#   .env               shared by both environments (app name, secrets)
#   .env.development   LOCAL   — used by `npm run dev`
#   .env.production    PROD    — used by `npm run build` and `npm run dev:prod`
#
# Vite merges them, later winning:
#   .env → .env.<mode> → .env.local → .env.<mode>.local
# So put a value in ONE place. A var set in both `.env` and a mode file is
# silently won by the mode file.
#
# ── Setup ────────────────────────────────────────────────────────────────────
#   cp .env.example .env               # then delete the two mode-only blocks
#   cp .env.example .env.development   # keep VITE_APP_ENV=local + local URL
#   cp .env.example .env.production    # keep VITE_APP_ENV=production + prod URL


# ── SHARED (.env) ────────────────────────────────────────────────────────────

# App name (optional — shown in browser tab)
VITE_APP_NAME=AnchorMart Admin

# Shared client secret for the `/api/chat/` mounts (attachment upload).
# The `/api/superadmin/` prefix is exempt and does not need it.
# Ask the backend team for the current value — never commit a real one here.
VITE_SERVER_SECRET_KEY=ANCHOR_MART_SERVER_SECRET_KEY


# ── PER ENVIRONMENT (.env.development / .env.production) ─────────────────────

# Which environment this build is. `local` in .env.development, `production` in
# .env.production.
#
# ⚠️ GATES MEDIA UPLOAD (Flow 26). Only the exact string `production` lets media
# bytes leave the browser:
#   production → presigned S3 POST runs; chat attachment button shown
#   anything else → slip is minted but the S3 POST is SKIPPED, and the chat
#                   attachment button is hidden
#
# Outside production an uploaded image therefore saves a real path with no
# object behind it — the record reads back as a broken image until it is
# re-saved on production. The UI says so at upload time.
#
# The check is exact and fails closed (src/lib/appEnv.ts): a typo, a blank value
# or a missing file all disable upload rather than enabling it.
VITE_APP_ENV=production

# API base URL (Django backend) — must end with /api, no space after the =.
#
# development: the dev server proxies "/api" here (vite.config.ts), so no CORS.
#              Free ngrok tunnels get a new subdomain on every restart, so paste
#              your current tunnel URL rather than reusing a committed one.
# production:  inlined into the bundle and called directly — the backend must
#              allow the panel's origin via CORS.
VITE_API_BASE_URL=ANCHOR_MART_ADMIN_URL

# Local backend instead:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api


# ── Browser push (Flow 21 §9) ────────────────────────────────────────────────
# Firebase Web config. Leave every line blank and push stays dark: the header
# button hides itself and nothing else in the panel changes. Fill all six in to
# turn it on — a partial config counts as unconfigured.
#
# Keep these in `.env` if both environments share one Firebase project; move
# them into the two mode files if they do not.
#
# Console → Project settings → General → "Your apps" → Web app → SDK setup:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
#
# Console → Project settings → Cloud Messaging → Web configuration → Web Push
# certificates. This is the PUBLIC half of the key pair ("Key pair" column), not
# the server key. Without it getToken() fails with token-subscribe-failed.
VITE_FIREBASE_VAPID_KEY=
#
# None of these are secrets — Firebase Web config identifies the project, it does
# not authorise anything. They ship in the bundle like every other VITE_* var.
# Use the SAME project the backend's FCM service account belongs to, or tokens
# registered here will be minted against a project the backend cannot push to.
