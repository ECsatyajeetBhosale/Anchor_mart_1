# Environment Variables — AnchorMart Admin
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this template is not.

# API base URL (Django backend) — must end with /api
# Free ngrok tunnels get a new subdomain on every restart, so paste your
# current tunnel URL here rather than reusing whatever is committed.
VITE_API_BASE_URL=ANCHOR_MART_ADMIN_URLs

# Local backend instead:
# VITE_API_BASE_URL=http://localhost:8000/api

# App name (optional — shown in browser tab)
VITE_APP_NAME=AnchorMart Admin

# Shared client secret for the `/api/chat/` mounts (attachment upload).
# The `/api/superadmin/` prefix is exempt and does not need it.
# Ask the backend team for the current value — never commit a real one here.
VITE_SERVER_SECRET_KEY=ANCHOR_MART_SERVER_SECRET_KEY
