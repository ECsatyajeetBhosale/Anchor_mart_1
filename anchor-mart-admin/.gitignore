node_modules
dist
.env
# Every real env file is gitignored; `.env.example` is the committed
# template. `.env.*` covers .env.development, .env.production and the
# .local overrides in one line.
.env.*
!.env.example
backend

# Build artifacts that must never sit beside their source.
# `tsconfig.node.json` type-checks vite.config.ts; when it emitted into this
# directory it produced a vite.config.js that Vite loaded *in preference to*
# the .ts, so config edits silently did nothing. Emit is redirected to
# node_modules/.tmp now — these entries are the second line of defence.
vite.config.js
vite.config.d.ts
